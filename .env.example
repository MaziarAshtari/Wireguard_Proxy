# Settings for run.py and python3 -m wgproxy. No shell commands, variable expansion,
# or multiline values. Use KEY=VALUE; # begins a comment after whitespace.
# Single/double quotes preserve spaces and # characters. Keep .env private (600).

# Paths are relative to this project, or absolute. Put WireGuard .conf files here.
CONFIG_DIR=configs
# Private configs, proxy lists, and the CSV report are written here.
OUTPUT_DIR=output

# Consecutive TCP ports, one authenticated SOCKS5 + HTTP mixed proxy per tunnel.
START_PORT=10000
# Local IPv4 bind address. Restrict access to trusted clients in your firewall.
LISTEN=0.0.0.0
# Advertised server IPv4; empty detects it over HTTPS (independent of tunnel exits).
PUBLIC_IP=
# Keep the fastest N passing tunnels. 20 is conservative for 1 GiB RAM; 0 keeps all.
MAX_PROXIES=20

# Credentials: 1..255 UTF-8 bytes each, no colons or control characters.
USERNAME=proxy
# Empty generates a strong password ONCE in .wgproxy-password (600).
# Keep that file for stable client links across rebuilds; values are never printed.
# Quote a supplied password if it contains spaces or # after whitespace.
PASSWORD=

# A successful attempt requires BOTH SOCKS5 and HTTP to return HTTP 204.
# Require MIN_SUCCESSES of TEST_ATTEMPTS (1 <= N <= M <= 100).
TEST_ATTEMPTS=3
MIN_SUCCESSES=2
# Deadline in seconds for each request, including connection and authentication.
TEST_TIMEOUT=8
# One temporary sing-box process at a time, with up to this many tunnels (1..200).
# Failed startup batches split recursively to isolate incompatible configs.
BATCH_SIZE=50
# Parallel tunnel checks within each batch (1..128); bounded by batch size.
TEST_CONCURRENCY=32

# IPv4 DNS resolver; each tunnel reaches it through its own WireGuard endpoint.
DNS_SERVER=1.1.1.1
# HTTP(S) validation target. It must return 204 and must not contain credentials.
TEST_URL=http://cp.cloudflare.com/generate_204

# true creates 2 GiB swap before validation if no swap is active (requires root).
# Default false makes no swap changes. Requires at least 3 GiB free disk if enabled.
CREATE_SWAP=false
# Empty installs latest stable if missing; or pin a stable version >= 1.12.0.
# An existing compatible binary is reused. Installation requires Linux x86_64/root.
SING_BOX_VERSION=
